# Local development only. Copy to .env and choose your own password.
# Keep values unquoted: Spring reads this file as Java properties.
POSTGRES_DB=omniplay
POSTGRES_USER=omniplay
POSTGRES_PASSWORD=your_database_password
POSTGRES_PORT=5432
SERVER_PORT=8080
# Optional override, must be a JDBC URL:
# DATABASE_URL=jdbc:postgresql://localhost:5432/omniplay
